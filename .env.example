# Required: token from @BotFather
BOT_TOKEN=123456789:replace_me

REDIS_URL=redis://redis:6379/0
DATABASE_PATH=/data/tytel.db
TEMP_DIR=/data/tmp
WORKER_CONCURRENCY=2

# Each valid link consumes one user and (when enabled) one group token.
USER_RATE_LIMIT=5
GROUP_RATE_LIMIT=0
MAX_DURATION_SECONDS=600
# Empty means 50 MB, or 2000 MB when LOCAL_BOT_API_URL is set.
MAX_FILE_SIZE_MB=
DEDUP_LOCK_TIMEOUT_SECONDS=1800
JOB_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO

# Host path mounted read-only at /app/cookies/cookies.txt in Docker.
COOKIES_PATH=./cookies.txt
# Optional yt-dlp proxy, for example http://user:password@proxy:8080
PROXY_URL=

# Optional local Telegram Bot API: http://telegram-bot-api:8081
LOCAL_BOT_API_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
